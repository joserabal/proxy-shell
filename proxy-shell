#!/bin/bash
# proxy-shell: isolated shell where ALL traffic is routed through a SOCKS5 proxy
# Dependencies: sing-box, iproute2
# Usage: sudo proxy-shell [options] <host:port> [command]
#
NS="psh-$$"
TUN_DEV="tun$$"
TUN_GW="198.18.0.1"         # TUN interface IP inside the namespace
FAKE_RANGE="198.18.0.0/15"  # Fake IP range for DNS fakeip
PID_FILE="/tmp/singbox-${$}.pid"
LOG_FILE="/tmp/singbox-${$}.log"
CONF_FILE="/tmp/singbox-${$}.json"
RCFILE="/tmp/proxy-shell-rc-${$}"
VETH_HOST="psh-h-${$}"       # Host end of the veth pair (--no-proxy bypass)
VETH_NS="psh-n-${$}"         # Namespace end of the veth pair (--no-proxy bypass)
# /30 from TEST-NET-2 (198.51.100.0/24, reserved). PID-keyed slot keeps
# parallel proxy-shells from clashing in the common case.
VETH_HOST_IP="198.51.100.$(( ($$ % 64) * 4 + 1 ))"
VETH_NS_IP="198.51.100.$(( ($$ % 64) * 4 + 2 ))"
PROXY_DNS=""                 # --dns: comma-separated DNS servers to use through proxy
LOCAL_DNS=0                  # --local-dns: resolve DNS locally, not through proxy
NO_PROXY=""                  # --no-proxy: comma-separated targets that bypass the proxy
NO_PROXY_DOMAINS=()          # populated from NO_PROXY: hostname/domain entries
NO_PROXY_CIDRS=()            # populated from NO_PROXY: IP/CIDR entries (always /N)
VERBOSE=1                    # 0 when a command is passed inline (non-interactive mode)
KEEP_ENV=0                   # --keep-env: run the inline command with the current environment
NAT_RULES=0                  # 1 once the host-side forwarding rules are installed
TUN_TIMEOUT=30               # failure threshold waiting for sing-box to create the TUN

set -e

log() { [ "$VERBOSE" -eq 1 ] || return 0; echo "$@"; }

# ── Dependency check ────────────────────────────────────────────────────────

install_singbox() {
    echo "[*] Downloading sing-box..."
    local arch
    case "$(uname -m)" in
        x86_64)  arch="amd64"  ;;
        aarch64) arch="arm64"  ;;
        armv7l)  arch="armv7"  ;;
        *) echo "[!] Unsupported architecture: $(uname -m)"; exit 1 ;;
    esac

    local version
    version=$(curl -fsSL "https://api.github.com/repos/SagerNet/sing-box/releases/latest" \
              | grep '"tag_name"' | cut -d'"' -f4)
    local ver="${version#v}"
    local url="https://github.com/SagerNet/sing-box/releases/download/${version}/sing-box-${ver}-linux-${arch}.tar.gz"

    local tmp
    tmp=$(mktemp -d)
    curl -fsSL "$url" | tar -xz -C "$tmp"
    install -m 755 "$tmp"/sing-box-*/sing-box /usr/local/bin/sing-box
    rm -rf "$tmp"
    echo "[*] sing-box ${version} installed."
}

check_deps() {
    local missing=()

    command -v ip       &>/dev/null || missing+=("iproute2")
    command -v sing-box &>/dev/null || missing+=("sing-box")
    command -v curl     &>/dev/null || missing+=("curl")
    command -v iptables &>/dev/null || missing+=("iptables")

    [ ${#missing[@]} -eq 0 ] && return 0

    echo ""
    echo "  Missing dependencies: ${missing[*]}"
    echo ""
    read -r -p "  Install now? [y/N] " answer </dev/tty
    [[ "$answer" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 1; }
    echo ""

    for dep in "${missing[@]}"; do
        case "$dep" in
            iproute2|curl|iptables)
                echo "[*] Installing ${dep}..."
                apt-get install -y "$dep" -qq
                ;;
            sing-box)
                install_singbox
                ;;
        esac
    done
}

# ── Global install ──────────────────────────────────────────────────────────

global_install() {
    local target="/usr/local/bin/proxy-shell"
    local script
    script="$(realpath "$0")"

    if [ "$script" = "$target" ]; then
        echo "[!] Already running from ${target}, nothing to do."
        exit 0
    fi

    echo "[*] Installing proxy-shell to ${target}..."
    install -m 755 "$script" "$target"
    echo "[*] Done. You can now run: sudo proxy-shell"

    echo ""
    check_deps
}

# ── --no-proxy parsing ──────────────────────────────────────────────────────

# Classify each comma-separated entry into NO_PROXY_DOMAINS or NO_PROXY_CIDRS.
# IPv4 addresses without prefix are normalized to /32.
classify_no_proxy() {
    [ -z "$NO_PROXY" ] && return 0

    local entry entries
    IFS=',' read -ra entries <<< "$NO_PROXY"
    for entry in "${entries[@]}"; do
        entry="${entry// /}"
        [ -z "$entry" ] && continue

        if [[ "$entry" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?$ ]]; then
            [[ "$entry" == */* ]] || entry="${entry}/32"
            NO_PROXY_CIDRS+=("$entry")
        elif [[ "$entry" =~ ^[A-Za-z0-9.-]+$ ]]; then
            NO_PROXY_DOMAINS+=("$entry")
        else
            echo "[!] Invalid --no-proxy entry: '${entry}'"
            exit 1
        fi
    done
}

# Resolve every hostname in NO_PROXY_DOMAINS to its IPv4 addresses and append them
# as /32 CIDRs to NO_PROXY_CIDRS. The bypass is enforced by per-CIDR routes in
# the namespace's routing table (see setup_no_proxy_bypass), so the destination
# IP must be known up front; pre-resolution is what produces those IPs without
# needing any L7 sniffing. The DNS rule still routes the hostname's queries to
# np-local so the app receives these same real IPs (rather than fakeip ones) and
# the per-CIDR route matches.
resolve_no_proxy_domains() {
    [ ${#NO_PROXY_DOMAINS[@]} -eq 0 ] && return 0

    local domain ips ip
    for domain in "${NO_PROXY_DOMAINS[@]}"; do
        ips=$(getent ahostsv4 "$domain" 2>/dev/null | awk '{print $1}' | sort -u)
        if [ -z "$ips" ]; then
            echo "[!] Could not resolve --no-proxy hostname: '${domain}'"
            exit 1
        fi
        while IFS= read -r ip; do
            [ -n "$ip" ] && NO_PROXY_CIDRS+=("${ip}/32")
        done <<< "$ips"
    done
}

_json_string_array() {
    local out="[" first=1 v
    for v in "$@"; do
        [ $first -eq 0 ] && out+=", "
        out+="\"${v}\""
        first=0
    done
    out+="]"
    printf '%s' "$out"
}

_np_active() {
    [ ${#NO_PROXY_DOMAINS[@]} -gt 0 ] || [ ${#NO_PROXY_CIDRS[@]} -gt 0 ]
}

# Extra DNS server entry (with leading comma) used as the resolver for bypassed
# targets and as the domain_resolver of the direct outbound (required by
# sing-box 1.12+).
_np_dns_server_entry() {
    _np_active || return 0
    printf ', {"tag": "np-local", "type": "local"}'
}

# DNS rule (with trailing comma) routing bypassed hostnames to the local resolver.
# Must come before the catch-all DNS rules.
_np_dns_rule_prefix() {
    [ ${#NO_PROXY_DOMAINS[@]} -eq 0 ] && return 0
    local doms; doms=$(_json_string_array "${NO_PROXY_DOMAINS[@]}")
    printf '{"domain_suffix": %s, "server": "np-local"}, ' "$doms"
}

# Returns 0 if any bypassed CIDR falls in 127.0.0.0/8. Loopback needs extra
# kernel-level plumbing (see setup_no_proxy_bypass).
_np_has_loopback() {
    local cidr
    for cidr in "${NO_PROXY_CIDRS[@]}"; do
        [[ "$cidr" =~ ^127\. ]] && return 0
    done
    return 1
}

# Returns 0 if any bypassed CIDR falls outside 127.0.0.0/8.
_np_has_non_loopback() {
    local cidr
    for cidr in "${NO_PROXY_CIDRS[@]}"; do
        [[ "$cidr" =~ ^127\. ]] || return 0
    done
    return 1
}

# ── Config generation ────────────────────────────────────────────────────────

# Default mode: fake IP DNS — hostnames resolved by the remote proxy.
# Tools see fake IPs (198.18.0.0/15), not real ones.
_gen_fakeip_config() {
    local prefix="$1"
    cat > "$CONF_FILE" <<EOF
{
  "log": {"level": "warn"},
  "dns": {
    "servers": [
      {"tag": "fp",     "type": "fakeip", "inet4_range": "${FAKE_RANGE}"},
      {"tag": "remote", "type": "tcp",    "server": "8.8.8.8", "detour": "proxy"}$(_np_dns_server_entry)
    ],
    "rules": [$(_np_dns_rule_prefix){"query_type": ["A", "AAAA"], "server": "fp"}],
    "final": "remote"
  },
  "inbounds": [{
    "type": "tun",
    "interface_name": "${TUN_DEV}",
    "address": ["${TUN_GW}/${prefix}"],
    "mtu": 9000,
    "auto_route": false,
    "stack": "gvisor"
  }],
  "outbounds": [{
    "type": "socks",
    "tag": "proxy",
    "server": "${PROXY_HOST}",
    "server_port": ${PROXY_PORT},
    "version": "5"
  }],
  "route": {
    "rules": [{"port": 53, "action": "hijack-dns"}],
    "final": "proxy"
  }
}
EOF
}

# --dns mode: DNS resolved via specified servers, routed through the proxy.
# Tools see real IPs. Requires a DNS server reachable through the proxy
# that knows about the target hostnames (e.g. an internal corporate DNS).
_gen_proxy_dns_config() {
    local prefix="$1"

    # Build JSON server entries from comma-separated PROXY_DNS list
    local servers_json=""
    local i=0
    IFS=',' read -ra dns_list <<< "$PROXY_DNS"
    for srv in "${dns_list[@]}"; do
        srv="${srv// /}"
        [ $i -gt 0 ] && servers_json+=$',\n      '
        servers_json+="{\"tag\": \"remote-${i}\", \"type\": \"tcp\", \"server\": \"${srv}\", \"detour\": \"proxy\"}"
        ((i++)) || true
    done

    cat > "$CONF_FILE" <<EOF
{
  "log": {"level": "warn"},
  "dns": {
    "servers": [
      ${servers_json}$(_np_dns_server_entry)
    ],
    "rules": [$(_np_dns_rule_prefix){"query_type": ["A", "AAAA"], "server": "remote-0"}],
    "final": "remote-0"
  },
  "inbounds": [{
    "type": "tun",
    "interface_name": "${TUN_DEV}",
    "address": ["${TUN_GW}/${prefix}"],
    "mtu": 9000,
    "auto_route": false,
    "stack": "gvisor"
  }],
  "outbounds": [{
    "type": "socks",
    "tag": "proxy",
    "server": "${PROXY_HOST}",
    "server_port": ${PROXY_PORT},
    "version": "5"
  }],
  "route": {
    "rules": [{"port": 53, "action": "hijack-dns"}],
    "final": "proxy"
  }
}
EOF
}

# --local-dns mode: DNS resolved by the local machine's resolver (not through proxy).
# Tools see real IPs. DNS queries are not tunneled — may leak to local network.
_gen_local_dns_config() {
    local prefix="$1"

    cat > "$CONF_FILE" <<EOF
{
  "log": {"level": "warn"},
  "dns": {
    "servers": [
      {"tag": "local", "type": "local"}$(_np_dns_server_entry)
    ],
    "rules": [$(_np_dns_rule_prefix){"query_type": ["A", "AAAA"], "server": "local"}],
    "final": "local"
  },
  "inbounds": [{
    "type": "tun",
    "interface_name": "${TUN_DEV}",
    "address": ["${TUN_GW}/${prefix}"],
    "mtu": 9000,
    "auto_route": false,
    "stack": "gvisor"
  }],
  "outbounds": [{
    "type": "socks",
    "tag": "proxy",
    "server": "${PROXY_HOST}",
    "server_port": ${PROXY_PORT},
    "version": "5"
  }],
  "route": {
    "rules": [{"port": 53, "action": "hijack-dns"}],
    "final": "proxy"
  }
}
EOF
}

generate_config() {
    local prefix="${FAKE_RANGE##*/}"
    if [ -n "$PROXY_DNS" ]; then
        _gen_proxy_dns_config "$prefix"
    elif [ "$LOCAL_DNS" -eq 1 ]; then
        _gen_local_dns_config "$prefix"
    else
        _gen_fakeip_config "$prefix"
    fi
}

# ── Setup / teardown ─────────────────────────────────────────────────────────

# Build a veth pair host↔namespace and program per-CIDR routes so bypassed
# traffic skips the TUN entirely. The kernel — not sing-box — owns the bypass
# decision, which is what makes this work uniformly for loopback and for any
# other IP/CIDR.
setup_no_proxy_bypass() {
    _np_active || return 0

    log "[*] Configuring no-proxy bypass via veth..."

    ip link add "$VETH_HOST" type veth peer name "$VETH_NS"
    ip link set "$VETH_NS" netns "$NS"
    ip addr add "${VETH_HOST_IP}/30" dev "$VETH_HOST"
    ip link set "$VETH_HOST" up
    ip netns exec "$NS" ip addr add "${VETH_NS_IP}/30" dev "$VETH_NS"
    ip netns exec "$NS" ip link set "$VETH_NS" up

    # The kernel's "local" routing table normally claims 127.0.0.0/8 at pref 0
    # and would hijack the destination before our per-CIDR route matched. Move
    # local to a lower priority and insert per-CIDR rules above it for the
    # loopback entries only. Non-loopback bypasses don't need this dance because
    # main-table specificity already wins against the TUN default route.
    if _np_has_loopback; then
        ip netns exec "$NS" ip rule del pref 0 2>/dev/null || true
        ip netns exec "$NS" ip rule add pref 100 lookup local
        # Allow loopback-sourced/destined packets to cross a non-loopback iface.
        # Without this the kernel drops them as "martian".
        sysctl -qw "net.ipv4.conf.${VETH_HOST}.route_localnet=1"
        ip netns exec "$NS" sysctl -qw "net.ipv4.conf.${VETH_NS}.route_localnet=1"
    fi

    local cidr
    for cidr in "${NO_PROXY_CIDRS[@]}"; do
        if [[ "$cidr" =~ ^127\. ]]; then
            ip netns exec "$NS" ip rule add pref 50 to "$cidr" lookup main
        fi
        ip netns exec "$NS" ip route add "$cidr" via "$VETH_HOST_IP" dev "$VETH_NS"
    done

    # Host side: forwarding and SNAT so reply traffic for non-loopback
    # destinations finds its way back through the veth. Loopback delivery is
    # local INPUT and needs neither, so a loopback-only bypass skips them.
    if _np_has_non_loopback; then
        NAT_RULES=1
        sysctl -qw net.ipv4.ip_forward=1
        iptables -t nat -A POSTROUTING -s "${VETH_NS_IP}/32" ! -d 127.0.0.0/8 \
            -m comment --comment "psh-${$}" -j MASQUERADE
        iptables -A FORWARD -i "$VETH_HOST" -m comment --comment "psh-${$}" -j ACCEPT
        iptables -A FORWARD -o "$VETH_HOST" -m comment --comment "psh-${$}" -j ACCEPT
    fi
}

# Blocks until sing-box has finished bringing the TUN device up, which is its
# last action on the interface: moving the device any earlier makes its
# post-start lookup fail and sing-box dies. TUN_TIMEOUT is a failure threshold,
# not a wait margin.
wait_for_tun() {
    local sb_pid deadline flags dev_flags
    sb_pid=$(cat "$PID_FILE")
    deadline=$(( SECONDS + TUN_TIMEOUT ))
    dev_flags="/sys/class/net/${TUN_DEV}/flags"

    while :; do
        # Guarded rather than redirected: a failing redirection is reported by
        # the shell itself, and the command's own 2>/dev/null does not mute it.
        flags=""
        if [ -r "$dev_flags" ]; then
            read -r flags < "$dev_flags" || flags=""
        fi
        if [ -n "$flags" ] && (( flags & 1 )); then    # IFF_UP
            return 0
        fi
        if ! kill -0 "$sb_pid" 2>/dev/null; then
            echo "[!] sing-box failed to start:"
            cat "$LOG_FILE"
            exit 1
        fi
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "[!] Timed out after ${TUN_TIMEOUT}s waiting for TUN device '${TUN_DEV}':"
            cat "$LOG_FILE"
            exit 1
        fi
        sleep 0.01
    done
}

setup() {
    log "[*] Creating network namespace..."
    ip netns add "$NS"

    log "[*] Starting sing-box..."
    generate_config
    # sing-box runs in the HOST namespace: direct access to PROXY_HOST:PROXY_PORT
    sing-box run -c "$CONF_FILE" &>"$LOG_FILE" &
    echo $! > "$PID_FILE"

    wait_for_tun

    log "[*] Moving TUN into proxy namespace..."
    # sing-box keeps its fd valid even after the interface moves to another namespace
    ip link set "$TUN_DEV" netns "$NS"
    ip netns exec "$NS" ip addr add "${TUN_GW}/15" dev "$TUN_DEV"
    ip netns exec "$NS" ip link set "$TUN_DEV" up
    ip netns exec "$NS" ip link set lo up
    ip netns exec "$NS" ip route add default dev "$TUN_DEV"

    log "[*] Configuring namespace DNS..."
    mkdir -p /etc/netns/"$NS"
    # Placeholder — sing-box intercepts all DNS on port 53 before it leaves the namespace
    echo "nameserver 8.8.8.8" > /etc/netns/"$NS"/resolv.conf

    setup_no_proxy_bypass

    local dns_label
    if [ -n "$PROXY_DNS" ]; then
        dns_label="real IPs via proxy (${PROXY_DNS})"
    elif [ "$LOCAL_DNS" -eq 1 ]; then
        dns_label="real IPs via local resolver (not tunneled)"
    else
        dns_label="fake IP — resolved by remote proxy"
    fi

    log ""
    log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    log " Proxified shell active"
    log " SOCKS5 proxy : ${PROXY_HOST}:${PROXY_PORT}"
    log " DNS          : ${dns_label}"
    if [ ${#NO_PROXY_DOMAINS[@]} -gt 0 ] || [ ${#NO_PROXY_CIDRS[@]} -gt 0 ]; then
        log " No-proxy     : ${NO_PROXY_DOMAINS[*]} ${NO_PROXY_CIDRS[*]}"
    fi
    log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

teardown() {
    log ""
    log "[*] Cleaning up..."
    kill "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null || true
    if [ "$NAT_RULES" -eq 1 ]; then
        iptables -t nat -D POSTROUTING -s "${VETH_NS_IP}/32" ! -d 127.0.0.0/8 \
            -m comment --comment "psh-${$}" -j MASQUERADE 2>/dev/null || true
        iptables -D FORWARD -i "$VETH_HOST" -m comment --comment "psh-${$}" -j ACCEPT 2>/dev/null || true
        iptables -D FORWARD -o "$VETH_HOST" -m comment --comment "psh-${$}" -j ACCEPT 2>/dev/null || true
    fi
    ip netns del "$NS" 2>/dev/null || true
    ip link del "$TUN_DEV" 2>/dev/null || true
    ip link del "$VETH_HOST" 2>/dev/null || true
    rm -f "$PID_FILE" "$LOG_FILE" "$CONF_FILE" "$RCFILE"
    rm -f /etc/netns/"$NS"/resolv.conf
    rmdir /etc/netns/"$NS" 2>/dev/null || true
    log "[*] Done."
}

# ── Usage ────────────────────────────────────────────────────────────────────

usage() {
    echo "Usage: sudo proxy-shell [options] <host:port> [command]"
    echo ""
    echo "  host:port   SOCKS5 proxy address (e.g. 127.0.0.1:8888)"
    echo "  command     Optional command to run inside the proxified namespace."
    echo "              If omitted, opens an interactive shell — ALL traffic from"
    echo "              every command you run will be transparently proxified."
    echo ""
    echo "Options:"
    echo "  --dns <servers>    Comma-separated DNS servers to use, routed through the proxy."
    echo "                     Tools see real IPs instead of fake ones. Use when you need"
    echo "                     real IPs in output or reports. Requires a DNS server"
    echo "                     reachable through the proxy (e.g. an internal corporate DNS)."
    echo "                     Example: --dns 10.0.0.53"
    echo "                              --dns 10.0.0.53,10.0.0.54"
    echo ""
    echo "  --local-dns        Resolve DNS using the local machine's resolver, not through"
    echo "                     the proxy. Tools see real IPs but DNS queries are not tunneled."
    echo "                     Note: --dns and --local-dns are mutually exclusive."
    echo ""
    echo "  --no-proxy <list>  Comma-separated targets that bypass the proxy and connect"
    echo "                     directly. Accepts hostnames, IPv4 addresses, and CIDR ranges."
    echo "                     Hostnames are resolved at startup and bypass is matched on the"
    echo "                     resulting IPs (works for any protocol — TCP, UDP, raw sockets)."
    echo "                     Bypass is enforced at the kernel level (veth + per-CIDR routes),"
    echo "                     so loopback addresses (127.0.0.0/8) work too — useful for chaining"
    echo "                     a local interception proxy (e.g. Burp on 127.0.0.1:8080) on top."
    echo "                     Example: --no-proxy example.com,10.0.0.0/8,127.0.0.1"
    echo ""
    echo "  --keep-env         Run the inline command with proxy-shell's own environment"
    echo "                     instead of rebuilding it from the login profiles. Skips the"
    echo "                     login shell, so startup is faster, but the caller is then"
    echo "                     responsible for passing a usable environment (PATH included)"
    echo "                     through, e.g. 'sudo -E'. Ignored in interactive mode."
    echo ""
    echo "  --global-install   Copy this script to /usr/local/bin and check dependencies."
    echo ""
    echo "Examples:"
    echo "  # Open a proxified interactive shell:"
    echo "  sudo proxy-shell 127.0.0.1:8888"
    echo ""
    echo "  # Run a single command through the proxy:"
    echo "  sudo proxy-shell 127.0.0.1:8888 curl https://ifconfig.me"
    echo ""
    echo "  # Use a specific DNS server to get real IPs in tool output:"
    echo "  sudo proxy-shell --dns 10.0.0.53 127.0.0.1:8888"
    echo ""
    echo "  # Bypass the proxy for a corporate network and a specific host:"
    echo "  sudo proxy-shell --no-proxy 10.0.0.0/8,internal.corp 127.0.0.1:8888"
    echo ""
    echo "  # Chain through a local Burp/mitmproxy on top of the SOCKS proxy:"
    echo "  sudo proxy-shell --no-proxy 127.0.0.1 127.0.0.1:8888 \\"
    echo "       bash -c 'http_proxy=http://127.0.0.1:8080 curl https://ifconfig.me'"
    exit 1
}

# ── Entry point ──────────────────────────────────────────────────────────────

if [ $# -eq 0 ]; then
    usage
fi

if [ "$EUID" -ne 0 ]; then
    echo "[!] This script must be run as root."
    echo "    Try: sudo $0 $*"
    exit 1
fi

# Parse options
while [[ "${1:-}" == --* ]]; do
    case "${1}" in
        --dns)
            [ -z "${2:-}" ] && { echo "[!] --dns requires an argument."; echo ""; usage; }
            [ "$LOCAL_DNS" -eq 1 ] && { echo "[!] --dns and --local-dns are mutually exclusive."; echo ""; usage; }
            PROXY_DNS="${2}"
            shift 2
            ;;
        --local-dns)
            [ -n "$PROXY_DNS" ] && { echo "[!] --dns and --local-dns are mutually exclusive."; echo ""; usage; }
            LOCAL_DNS=1
            shift
            ;;
        --no-proxy)
            [ -z "${2:-}" ] && { echo "[!] --no-proxy requires an argument."; echo ""; usage; }
            NO_PROXY="${2}"
            shift 2
            ;;
        --keep-env)
            KEEP_ENV=1
            shift
            ;;
        --global-install)
            global_install
            exit 0
            ;;
        *)
            echo "[!] Unknown option: ${1}"
            echo ""
            usage
            ;;
    esac
done

if [ "$KEEP_ENV" -eq 1 ]; then
    if [ -z "$SUDO_UID" ] || [ -z "$SUDO_GID" ]; then
        echo "[!] --keep-env requires invoking proxy-shell through sudo (SUDO_UID/SUDO_GID unset)."
        exit 1
    fi
    if ! command -v setpriv &>/dev/null; then
        echo "[!] --keep-env requires setpriv (util-linux)."
        exit 1
    fi
fi

# Parse host:port
PROXY_ADDR="${1}"
PROXY_HOST="${PROXY_ADDR%%:*}"
PROXY_PORT="${PROXY_ADDR##*:}"

if [ -z "$PROXY_HOST" ] || [ -z "$PROXY_PORT" ] || [ "$PROXY_HOST" = "$PROXY_ADDR" ]; then
    echo "[!] Invalid proxy address: '${PROXY_ADDR}' — expected host:port"
    echo ""
    usage
fi

if ! [[ "$PROXY_PORT" =~ ^[0-9]+$ ]] || [ "$PROXY_PORT" -lt 1 ] || [ "$PROXY_PORT" -gt 65535 ]; then
    echo "[!] Invalid port: '${PROXY_PORT}' — must be a number between 1 and 65535"
    echo ""
    usage
fi

# Resolve hostname to IP — sing-box requires a numeric address for outbound servers
if ! [[ "$PROXY_HOST" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    RESOLVED=$(getent hosts "$PROXY_HOST" 2>/dev/null | awk '{print $1; exit}')
    if [ -z "$RESOLVED" ]; then
        echo "[!] Could not resolve hostname: '${PROXY_HOST}'"
        exit 1
    fi
    PROXY_HOST="$RESOLVED"
fi

shift  # remove host:port from "$@"; remaining args are the optional command
[ $# -gt 0 ] && VERBOSE=0

# Clean up orphans left by crashed previous instances: /etc/netns dirs, host-side
# veth links, and tagged iptables rules. Anything tagged psh-<pid> whose netns
# no longer exists is fair game.
declare -A _psh_orphan_pids=()
for dir in /etc/netns/psh-*/; do
    [ -d "$dir" ] || continue
    ns="${dir%/}"; ns="${ns##*/}"
    _psh_orphan_pids["${ns#psh-}"]=1
done
for iface in $(ip -o link show 2>/dev/null | awk -F': ' '/psh-h-/ {print $2}' | sed 's/@.*//'); do
    _psh_orphan_pids["${iface#psh-h-}"]=1
done
for pid in $(iptables-save 2>/dev/null | grep -oP 'comment "psh-\K[0-9]+' | sort -u); do
    _psh_orphan_pids[$pid]=1
done

for pid in "${!_psh_orphan_pids[@]}"; do
    ns="psh-${pid}"
    ip netns list 2>/dev/null | grep -q "^${ns} " && continue
    rm -f "/etc/netns/${ns}/resolv.conf"
    rmdir "/etc/netns/${ns}" 2>/dev/null || true
    orphan_ns_ip="198.51.100.$(( (pid % 64) * 4 + 2 ))"
    orphan_veth="psh-h-${pid}"
    iptables -t nat -D POSTROUTING -s "${orphan_ns_ip}/32" ! -d 127.0.0.0/8 \
        -m comment --comment "psh-${pid}" -j MASQUERADE 2>/dev/null || true
    iptables -D FORWARD -i "$orphan_veth" -m comment --comment "psh-${pid}" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -o "$orphan_veth" -m comment --comment "psh-${pid}" -j ACCEPT 2>/dev/null || true
    ip link del "$orphan_veth" 2>/dev/null || true
done
unset _psh_orphan_pids

classify_no_proxy
resolve_no_proxy_domains

check_deps

trap teardown EXIT

setup

# Use the user's login shell so their profile chain sets PATH/env as in a
# normal terminal. Fish doesn't support the `exec "$@"` idiom — fall back to bash.
USER_SHELL=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f7)
[ -x "$USER_SHELL" ] || USER_SHELL=/bin/bash
case "$USER_SHELL" in
    */fish) USER_SHELL=/bin/bash ;;
esac

if [ $# -eq 0 ]; then
    # Replicate login init from the rcfile (bash --rcfile is non-login) and
    # guard against ~/.profile chaining to ~/.bashrc and sourcing it twice.
    cat > "$RCFILE" <<'RCEOF'
__psh_source() {
    [ -f "$1" ] || return
    case ":$__psh_sourced:" in *":$1:"*) return ;; esac
    __psh_sourced="${__psh_sourced}:$1"
    . "$1"
}
__psh_source /etc/profile
for __psh_f in ~/.bash_profile ~/.bash_login ~/.profile; do
    [ -f "$__psh_f" ] && { __psh_source "$__psh_f"; break; }
done
__psh_source ~/.bashrc
unset -f __psh_source
unset __psh_sourced __psh_f

force_color_prompt=yes
PS1='\[\e[38;5;232m\]\[\e[48;5;82m\] proxified \[\e[0m\]\[\e[38;5;82m\]❯\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] \$ '
RCEOF
    chown "$SUDO_USER" "$RCFILE"
    ip netns exec "$NS" sudo -u "$SUDO_USER" \
        env TERM="${TERM:-xterm-256color}" \
        bash --rcfile "$RCFILE"
elif [ "$KEEP_ENV" -eq 1 ]; then
    # setpriv drops to the invoking user without touching the environment, so
    # the command runs with exactly the one proxy-shell received.
    ip netns exec "$NS" \
        setpriv --reuid="$SUDO_UID" --regid="$SUDO_GID" --init-groups -- "$@"
else
    # -i bypasses ~/.bashrc's early-return for non-interactive shells (which
    # would drop pnpm/asdf/etc.); `exec "$@"` preserves argv (no shell -c
    # re-parsing). The fd dance silences bash's cosmetic job-control warnings
    # when invoked without a controlling TTY (cron, agents, subprocess, ...):
    # a non-interactive bash (no warnings itself) opens fd 3 = real stderr and
    # redirects fd 2 = /dev/null, then execs the interactive bash whose -c body
    # restores fd 2 from fd 3 before running the user's command. The fd 3 trick
    # has to happen post-sudo because sudo closes fds > 2.
    ip netns exec "$NS" sudo -u "$SUDO_USER" \
        bash -c '
            shell="$1"; shift
            exec "$shell" -li -c "exec 2>&3 3>&-; exec \"\$@\"" _ "$@" 3>&2 2>/dev/null
        ' _ "$USER_SHELL" "$@"
fi

